{
  "metadata": {
    "title": "dtrack Test Suite",
    "subtitle": "pair set: int"
  },
  "pairs": {
    "oracle_date_vs_aws_int": {
      "description": "Oracle DATE vs AWS INTEGER YYYYMMDD with MAX subquery CTE. ~5% of days have count diffs.",
      "left": {
        "table": "POS_DAILY",
        "source": "oracle",
        "conn_macro": "pb30",
        "date_col": "POS_DT",
        "date_type": "date"
      },
      "right": {
        "table": "pos_snapshot",
        "source": "aws",
        "conn_macro": "warehouse_db",
        "date_col": "int_date",
        "date_type": "num",
        "processed": "SELECT * FROM warehouse_db.pos_snapshot WHERE int_date = (SELECT MAX(int_date) FROM warehouse_db.pos_snapshot)"
      },
      "mode": "incremental",
      "fromDate": "2024-10-01",
      "toDate": "2024-12-31",
      "where_map": {
        "left": "POS_DT >= '2024-10-02' AND POS_DT <= '2024-12-31' AND POS_DT NOT IN ('2024-10-01', '2024-10-09', '2024-10-10', '2024-10-31', '2024-11-21')",
        "right": "int_date >= '20241002' AND int_date <= '20241231' AND int_date NOT IN ('20241001', '20241009', '20241010', '20241031', '20241121')"
      },
      "time_map": {
        "row": {
          "left": "\u2014",
          "right": "\u2014"
        },
        "col": {
          "left": "\u2014",
          "right": "\u2014"
        }
      },
      "comment_map": {
        "row": {
          "left": "",
          "right": ""
        },
        "col": {
          "left": "",
          "right": ""
        }
      },
      "diff_map": {}
    }
  }
}