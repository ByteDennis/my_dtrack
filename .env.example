AWS_DEFAULT_REGION=us-east-1
DTRACK_S3=s3://replace-me/dtrack/work/runs/<run_id>
DTRACK_REPORT_S3=s3://replace-me/dtrack/report
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=
# dtrack dbx defaults (needs dtrack[dbx]): profile in ~/.databrickscfg, cluster and warehouse ids
# DTRACK_DBX_PROFILE=corp
# DTRACK_DBX_CLUSTER_ID=
# DTRACK_DBX_WAREHOUSE_ID=
# dtrack dbx s3: source profile, static profile for WinSCP, saved WinSCP site, WinSCP.exe path
# DTRACK_AWS_PROFILE=corp
# DTRACK_AWS_TARGET=corp-winscp
# DTRACK_WINSCP_SITE=corp-s3
# DTRACK_WINSCP=C:\Program Files (x86)\WinSCP\WinSCP.exe
# per server, by conn_macro name: <macro>_USR / <macro>_PWD / <macro>_DSN
# DTRACK_ORACLE_MACROS=pb30:svc30
# LDAP_DSN=ldap://oid:389/{service},cn=OracleContext,dc=example
