# Required for Oracle Left unless left_options_json names custom credential variables.
ORACLE_USER=
ORACLE_PASSWORD=
# For left_conn macros, define the macro password and optional service alias.
# PB30_PWD=
# ORACLE_SVC=pb30:service,pcds:service

# Required only when ORACLE_SVC/left_options_json does not provide the service or DSN.
# ORACLE_DSN=
# Oracle through LDAP naming: the URL carries the service, so ORACLE_SVC/ORACLE_DSN are not needed.
# {service} in the URL is filled from ORACLE_SVC; <MACRO>_LDAP_DSN overrides it per macro.
# LDAP_DSN=ldap://ldap.corp:389/PRODSVC,cn=OracleContext,dc=corp,dc=com
# HADOOP_DSN=hive

# Databricks authentication remains in ~/.databrickscfg.
DBX_PROFILE=corp
DBX_AUTH_TYPE=external-browser
DBX_CLUSTER_ID=
DBX_WAREHOUSE_ID=
DBX_WORKSPACE_PDIR=
DBX_JOB_NAME=pair_recon_right
# Optional: upload src/pair_recon_right under another Workspace folder name.
# DBX_PKG_RENAME=pair_recon_right -> pair_recon
DBX_PAIR_TABLE=
DBX_PAIR_WORKBOOK=setup/pairs.xlsx
# true: upsert local workbook changes first; false: use Databricks metadata only.
DBX_SYNC_PAIR_METADATA=true
DBX_STATUS_TABLE=
DBX_ERROR_TABLE=
DBX_RUN_PATH=

# Optional runtime defaults.
PAIR_RECON_TIMEZONE=America/New_York
PAIR_RECON_OUTPUT_DIR=outputs
STATS_WORKERS=2
