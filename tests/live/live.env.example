# Copy to tests/live/live.env (git-ignored) and fill in. Only tests/live reads it.

# --- AWS: boto3's normal credential chain (profile, SSO, env keys) ---
AWS_PROFILE=default
AWS_DEFAULT_REGION=us-east-1

# Scratch prefix for the S3 store tests; everything under it is deleted afterwards
DTRACK_LIVE_S3=s3://my-bucket/dtrack-live

# The SAME folders seen two ways: as S3 (Left side, boto3) and as a UC Volume (Right side)
DTRACK_LIVE_S3_WORK=s3://my-bucket/dtrack/work
DTRACK_LIVE_VOLUME_WORK=/Volumes/dev/dtrack/work
DTRACK_LIVE_S3_REPORT=s3://my-bucket/dtrack/report
DTRACK_LIVE_VOLUME_REPORT=/Volumes/dev/dtrack/report

# No external Volume (Databricks Free Edition): leave the two VOLUME lines empty and name the
# secret scope that holds an S3 key for the job; the job then reads s3:// directly
DTRACK_LIVE_AWS_SECRET_SCOPE=

# --- Databricks: a profile in ~/.databrickscfg (browser login works) ---
DATABRICKS_CONFIG_PROFILE=corp
# "serverless" or an all-purpose cluster id
DTRACK_LIVE_COMPUTE=serverless
# catalog.schema where the tests may CREATE and DROP tables
DTRACK_LIVE_SCHEMA=dev.dtrack_live
# workspace folder the Right package is uploaded to for the job test
DTRACK_LIVE_WORKSPACE_DIR=/Workspace/Users/me@example.com/dtrack_live

# 1 keeps tables, S3 objects and the workspace folder after the run, for inspection
DTRACK_LIVE_KEEP=0
